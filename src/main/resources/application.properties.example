spring.application.name=prguard

# Google Gemini API Key 설정
# Google AI Studio에서 발급받은 API 키를 설정하거나 환경 변수(GEMINI_API_KEY)로 주입하세요.
gemini.api.key=${GEMINI_API_KEY:YOUR_GEMINI_API_KEY_HERE}
gemini.model=gemini-3.5-flash-lite

# GitHub App 설정
# GitHub App Settings > General 에서 확인
github.app.id=${GITHUB_APP_ID:YOUR_GITHUB_APP_ID}
# GitHub App 에서 다운로드한 Private Key (.pem) 파일 경로
github.app.private-key-path=${GITHUB_APP_PRIVATE_KEY_PATH:pr-guard-pg.private-key.pem}
# 웹훅 페이로드에 installation.id 가 없을 경우 사용할 기본 설치 ID (선택 사항)
github.app.default-installation-id=${GITHUB_INSTALLATION_ID:}

